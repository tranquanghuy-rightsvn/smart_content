// contents.web100.vn — trang nháp để khách duyệt nội dung trước khi đăng lên site chính.
// Toàn bộ subdomain KHÔNG index (xem public/_headers + header trong src/worker.js).
// public/ là HTML/CSS tĩnh (git push là Cloudflare Workers Builds tự deploy);
// src/worker.js chỉ chạy cho /api/* (lưu/đọc góp ý trong D1).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-content",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Chưa gắn domain: gắn contents.web100.vn trong Cloudflare Dashboard khi sẵn sàng.
  // Trước đó xem thử qua địa chỉ smart-content.<tài-khoản>.workers.dev
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web100-contents",
      "database_id": "4c9ea511-12e8-492d-873c-400e5f5100ae",
      "migrations_dir": "migrations"
    }
  ]
}
