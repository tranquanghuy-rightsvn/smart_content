# contents.web100.vn là bản nháp để khách duyệt: KHÔNG index, KHÔNG follow link, KHÔNG lưu cache
# trên Google/Bing, cho TOÀN BỘ đường dẫn. Cố ý KHÔNG có robots.txt chặn (Disallow): nếu chặn,
# bot không đọc được header noindex này và URL vẫn có thể lên Google khi bị chia sẻ.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

# Font/CSS của từng site khách đổi rất ít
/*/_assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
